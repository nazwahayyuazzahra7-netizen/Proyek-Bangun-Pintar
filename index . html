<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>BangunPintar - 10 Kuis Alarm</title>
<script src="https://accounts.google.com/gsi/client" async defer></script>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;700;800&family=JetBrains+Mono:wght@700&display=swap');
  :root{ --bg:#0B0F1A; --card:#151B2A; --card2:#1E2738; --border:#243049; --primary:#FFC300; --text:#F8FAFC; --muted:#94A3B8; --success:#22C55E; --danger:#EF4444; }
  *{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
  body{font-family:'Plus Jakarta Sans',system-ui,sans-serif;background:var(--bg);color:var(--text);min-height:100vh;overflow-x:hidden;}
  .bg-glow{position:fixed;top:-200px;left:50%;transform:translateX(-50%);width:800px;height:600px;background:radial-gradient(ellipse at center,rgba(255,195,0,0.15) 0%,rgba(0,0,0,0) 70%);pointer-events:none;z-index:0;}
  .login-page{position:fixed; inset:0; z-index:20000; background:var(--bg); display:flex; align-items:center; justify-content:center; padding:20px;}
  .login-page.hidden{display:none;}
  .login-card{width:100%; max-width:400px; background:linear-gradient(180deg,var(--card) 0%,#111726 100%); border:1px solid var(--border); border-radius:28px; padding:32px 28px; text-align:center; box-shadow:0 30px 80px rgba(0,0,0,0.6);}
  .login-logo{width:64px; height:64px; background:var(--primary); border-radius:18px; display:grid; place-items:center; margin:0 auto 16px; font-size:32px; color:#000;}
  .login-title{font-size:26px; font-weight:800; letter-spacing:-0.8px; margin-bottom:8px;}
  .login-sub{font-size:14px; color:var(--muted); line-height:1.5; margin-bottom:28px;}
  .google-btn-wrap{display:flex; justify-content:center; margin-bottom:16px; min-height:44px;}
  .btn-google-custom{width:100%; background:#fff; color:#000; border:none; border-radius:14px; padding:14px 16px; font-weight:700; font-size:14px; display:flex; align-items:center; justify-content:center; gap:10px; cursor:pointer; transition:0.2s;}
  .btn-google-custom:hover{transform:translateY(-1px); box-shadow:0 8px 20px rgba(255,255,255,0.15);}
  .divider{display:flex; align-items:center; gap:12px; margin:20px 0; color:var(--muted); font-size:12px; font-weight:700; letter-spacing:1px; text-transform:uppercase;}
  .divider::before,.divider::after{content:''; flex:1; height:1px; background:var(--border);}
  .demo-login-form{display:grid; gap:10px; text-align:left;}
  .demo-login-form label{font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:0.8px; color:var(--muted);}
  .demo-login-form input{width:100%; background:var(--card2); border:1px solid var(--border); border-radius:12px; padding:14px; color:var(--text); font-family:inherit; font-weight:600; font-size:14px; outline:none;}
  .demo-login-form input:focus{border-color:var(--primary);}
  .btn-demo{width:100%; background:var(--card2); border:1px solid var(--border); color:var(--text); border-radius:14px; padding:14px; font-weight:700; cursor:pointer; margin-top:4px;}
  .login-foot{margin-top:20px; font-size:11px; color:var(--muted); line-height:1.5;} .login-foot b{color:var(--primary);}
  .container{max-width:520px; margin:0 auto; padding:20px 20px 100px; position:relative; z-index:1;}
  .header{display:flex; justify-content:space-between; align-items:center; margin-bottom:28px;}
  .logo{display:flex; align-items:center; gap:10px; font-weight:800; font-size:20px; letter-spacing:-0.5px;}
  .logo-icon{width:40px; height:40px; background:var(--primary); border-radius:12px; display:grid; place-items:center; color:#000; font-size:22px;}
  .user-menu{display:flex; align-items:center; gap:10px; background:var(--card); border:1px solid var(--border); padding:6px 6px 6px 10px; border-radius:100px; cursor:pointer; position:relative;}
  .user-avatar{width:32px; height:32px; border-radius:50%; object-fit:cover; background:var(--card2);}
  .user-info{text-align:left; max-width:110px;} .user-name{font-size:12px; font-weight:700; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:100px;} .user-email{font-size:10px; color:var(--muted); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:100px;}
  .dropdown{position:absolute; top:48px; right:0; background:var(--card); border:1px solid var(--border); border-radius:14px; padding:8px; width:180px; display:none; z-index:100; box-shadow:0 20px 40px rgba(0,0,0,0.5);} .dropdown.show{display:block;}
  .dropdown button{width:100%; text-align:left; background:none; border:none; color:var(--text); padding:10px 12px; border-radius:8px; font-size:13px; font-weight:600; cursor:pointer; display:flex; gap:8px; align-items:center;} .dropdown button:hover{background:var(--card2);} .dropdown button.danger{color:var(--danger);}
  .clock-card{background:linear-gradient(180deg,var(--card) 0%,#111726 100%); border:1px solid var(--border); border-radius:28px; padding:28px 24px; text-align:center; margin-bottom:24px; box-shadow:0 20px 60px rgba(0,0,0,0.4), inset 0 1px 0 rgba(255,255,255,0.05);}
  .current-time{font-family:'JetBrains Mono',monospace; font-size:64px; font-weight:800; letter-spacing:-3px; line-height:1; margin-bottom:6px;} .current-date{color:var(--muted); font-size:14px; font-weight:500;}
  .next-alarm{margin-top:18px; background:rgba(255,195,0,0.08); border:1px dashed rgba(255,195,0,0.3); border-radius:14px; padding:10px; font-size:13px; color:var(--primary);}
  .section-title{font-size:15px; font-weight:700; margin:24px 0 12px; display:flex; justify-content:space-between; align-items:center;} .section-title span{color:var(--muted); font-weight:500; font-size:12px;}
  .card{background:var(--card); border:1px solid var(--border); border-radius:20px; padding:18px;}
  .form-grid{display:grid; gap:14px;} .input-row{display:grid; grid-template-columns:1fr 1fr; gap:12px;}
  .field label{display:block; font-size:11px; font-weight:700; letter-spacing:0.8px; text-transform:uppercase; color:var(--muted); margin-bottom:8px;}
  .field input,.field select{width:100%; background:var(--card2); border:1px solid var(--border); border-radius:12px; padding:14px; color:var(--text); font-family:inherit; font-weight:600; font-size:15px; outline:none; transition:0.2s;}
  .field input:focus,.field select:focus{border-color:var(--primary); box-shadow:0 0 0 3px rgba(255,195,0,0.15);}
  .quiz-options{display:grid; grid-template-columns:1fr 1fr; gap:8px;}
  .quiz-opt{background:var(--card2); border:1.5px solid var(--border); border-radius:12px; padding:10px 12px; cursor:pointer; text-align:left; transition:0.2s; position:relative; overflow:hidden;}
  .quiz-opt.active{border-color:var(--primary); background:rgba(255,195,0,0.1);} .quiz-opt .icon{font-size:18px; margin-bottom:4px;} .quiz-opt .t{font-size:12px; font-weight:700; line-height:1.2;} .quiz-opt .d{font-size:10px; color:var(--muted); margin-top:2px; line-height:1.2;}
  .quiz-opt .num{position:absolute; top:6px; right:8px; font-size:9px; font-weight:800; background:var(--border); color:var(--muted); width:16px; height:16px; border-radius:50%; display:grid; place-items:center;}
  .quiz-opt.active .num{background:var(--primary); color:#000;}
  .btn-primary{width:100%; background:var(--primary); color:#000; border:none; border-radius:14px; padding:16px; font-weight:800; font-size:15px; cursor:pointer; letter-spacing:-0.2px; transition:0.2s; display:flex; align-items:center; justify-content:center; gap:8px;}
  .btn-primary:active{transform:scale(0.98);} .btn-primary:disabled{opacity:0.5;}
  .alarm-list{display:grid; gap:10px;}
  .alarm-item{background:var(--card); border:1px solid var(--border); border-radius:18px; padding:16px 18px; display:flex; justify-content:space-between; align-items:center; transition:0.2s;}
  .alarm-item.disabled{opacity:0.5;} .alarm-time{font-family:'JetBrains Mono',monospace; font-size:28px; font-weight:800; letter-spacing:-1px;}
  .alarm-meta{font-size:12px; color:var(--muted); margin-top:2px; display:flex; gap:6px; align-items:center; flex-wrap:wrap;} .alarm-meta .pill{background:var(--card2); border:1px solid var(--border); padding:2px 8px; border-radius:100px; font-size:10px; font-weight:700; text-transform:uppercase;}
  .toggle{width:48px; height:28px; background:var(--card2); border:1px solid var(--border); border-radius:100px; position:relative; cursor:pointer; transition:0.3s;} .toggle::after{content:''; position:absolute; top:2px; left:2px; width:22px; height:22px; background:#fff; border-radius:50%; transition:0.3s; box-shadow:0 2px 6px rgba(0,0,0,0.3);} .toggle.on{background:var(--primary); border-color:var(--primary);} .toggle.on::after{transform:translateX(20px); background:#000;}
  .stats-grid{display:grid; grid-template-columns:1fr 1fr 1fr; gap:10px;} .stat{background:var(--card); border:1px solid var(--border); border-radius:16px; padding:14px; text-align:center;} .stat b{font-size:20px; display:block;} .stat span{font-size:11px; color:var(--muted); text-transform:uppercase; font-weight:700; letter-spacing:0.5px;}
  .alarm-overlay{position:fixed; inset:0; z-index:9999; background:#0B0F1A; display:none; flex-direction:column; overflow-y:auto; overflow-x:hidden; -webkit-overflow-scrolling:touch; overscroll-behavior:contain;}
  .alarm-overlay.active{display:flex;} .alarm-overlay-top{background:linear-gradient(180deg,#FF3B30 0%,#B91C1C 100%); padding:30px 24px 24px; text-align:center; animation:pulseBg 1s infinite alternate; flex-shrink:0; position:sticky; top:0; z-index:2; box-shadow:0 10px 30px rgba(0,0,0,0.3);}
  @keyframes pulseBg{0%{filter:brightness(1)}100%{filter:brightness(1.2)}} .alarm-overlay-top .time{font-family:'JetBrains Mono'; font-size:52px; font-weight:800; letter-spacing:-2px;} .alarm-overlay-top .label{font-size:14px; opacity:0.9; margin-top:4px; font-weight:600;}
  .alarm-overlay-body{flex:1; padding:24px 24px 40px; display:flex; flex-direction:column; justify-content:flex-start; max-width:480px; margin:0 auto; width:100%; overflow-y:auto; overflow-x:hidden; min-height:0; -webkit-overflow-scrolling:touch;}
  .quiz-card{background:var(--card); border:1px solid var(--border); border-radius:24px; padding:24px; box-shadow:0 20px 60px rgba(0,0,0,0.5); margin:auto 0; width:100%; max-height:none; overflow:visible;}
  .quiz-header{display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;} .quiz-badge{background:var(--primary); color:#000; padding:6px 12px; border-radius:100px; font-size:11px; font-weight:800; letter-spacing:0.5px;} .snooze-count{font-size:12px; color:var(--muted); font-weight:600;}
  .quiz-question{font-size:22px; font-weight:800; line-height:1.25; margin-bottom:8px; letter-spacing:-0.3px;} .quiz-hint{font-size:13px; color:var(--muted); margin-bottom:20px; line-height:1.4;}
  .quiz-input{width:100%; background:var(--bg); border:2px solid var(--border); border-radius:14px; padding:18px; font-size:20px; font-weight:800; font-family:'JetBrains Mono'; color:var(--text); text-align:center; outline:none; transition:0.2s; letter-spacing:1px;}
  .quiz-input:focus{border-color:var(--primary);} .quiz-input.shake{animation:shake 0.4s;} @keyframes shake{0%,100%{transform:translateX(0)}25%{transform:translateX(-8px)}75%{transform:translateX(8px)}}
  .quiz-actions{display:grid; grid-template-columns:1fr 1.5fr; gap:12px; margin-top:16px;} .btn-snooze{background:var(--card2); border:1px solid var(--border); color:var(--text); border-radius:14px; padding:16px; font-weight:700; cursor:pointer;}
  .memory-grid{display:grid; grid-template-columns:repeat(4,1fr); gap:10px; margin:20px 0;} .memory-cell{aspect-ratio:1; background:var(--card2); border:2px solid var(--border); border-radius:14px; display:grid; place-items:center; font-size:28px; cursor:pointer; transition:0.15s;} .memory-cell.active{background:var(--primary); border-color:var(--primary); transform:scale(0.95);}
  .puzzle-grid{display:grid; gap:8px; margin:18px 0; background:var(--bg); padding:10px; border-radius:16px; border:1px solid var(--border);} .puzzle-tile{aspect-ratio:1; background:var(--card2); border:2px solid var(--border); border-radius:12px; display:grid; place-items:center; font-family:'JetBrains Mono'; font-size:22px; font-weight:800; cursor:pointer; transition:0.15s; user-select:none; color:var(--text);} .puzzle-tile:not(.empty):hover{border-color:var(--primary); transform:scale(1.02); background:var(--card);} .puzzle-tile.empty{background:transparent; border:2px dashed var(--border); cursor:default;} .puzzle-tile.correct{background:rgba(34,197,94,0.15); border-color:var(--success); color:var(--success);}
  .puzzle-stats{display:flex; justify-content:space-between; align-items:center; font-size:12px; color:var(--muted); margin-bottom:8px; font-weight:600;} .puzzle-stats b{color:var(--text); font-family:'JetBrains Mono'; font-size:14px;}
  .typing-display{background:var(--bg); border:1px solid var(--border); border-radius:12px; padding:14px; font-size:14px; line-height:1.5; margin-bottom:12px; color:var(--muted);} .typing-display b{color:var(--text);}
  /* NEW QUIZ STYLES */
  .color-word{font-size:48px; font-weight:900; letter-spacing:-1px; text-align:center; padding:20px; background:var(--bg); border-radius:16px; border:1px solid var(--border); margin:12px 0; font-family:'Plus Jakarta Sans';}
  .color-options{display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-top:12px;} .color-btn{padding:14px; border-radius:12px; border:2px solid var(--border); background:var(--card2); color:var(--text); font-weight:700; font-size:13px; cursor:pointer; display:flex; align-items:center; gap:8px; transition:0.2s;} .color-btn:hover{border-color:var(--primary); transform:scale(1.02);} .color-dot{width:18px; height:18px; border-radius:50%; flex-shrink:0; border:2px solid rgba(255,255,255,0.2);}
  .sort-grid{display:flex; flex-wrap:wrap; gap:8px; justify-content:center; margin:16px 0;} .sort-tile{min-width:56px; height:56px; background:var(--card2); border:2px solid var(--border); border-radius:12px; display:grid; place-items:center; font-family:'JetBrains Mono'; font-size:20px; font-weight:800; cursor:pointer; transition:0.2s;} .sort-tile:hover{border-color:var(--primary);} .sort-tile.selected{background:var(--primary); color:#000; border-color:var(--primary);} .sort-tile.correct{background:var(--success); color:#fff; border-color:var(--success); cursor:default;}
  .sort-progress{display:flex; gap:6px; justify-content:center; margin:12px 0; flex-wrap:wrap;} .sort-progress-item{padding:6px 12px; background:var(--bg); border:1px solid var(--border); border-radius:100px; font-family:'JetBrains Mono'; font-size:12px; font-weight:700;}
  .emoji-display{font-size:42px; text-align:center; padding:20px; background:var(--bg); border-radius:16px; border:1px solid var(--border); margin:12px 0; letter-spacing:4px; line-height:1.3;}
  .focus-area{position:relative; width:100%; height:260px; background:var(--bg); border:2px dashed var(--border); border-radius:16px; margin:16px 0; overflow:hidden; touch-action:none;}
  .focus-target{position:absolute; width:64px; height:64px; background:var(--primary); border-radius:50%; display:grid; place-items:center; font-weight:800; color:#000; cursor:pointer; box-shadow:0 4px 20px rgba(255,195,0,0.4); transition:all 0.15s cubic-bezier(0.34,1.56,0.64,1); user-select:none; font-size:20px;}
  .focus-target:active{transform:scale(0.9);} .focus-bar{height:10px; background:var(--card2); border-radius:100px; overflow:hidden; margin:12px 0;} .focus-bar-fill{height:100%; background:var(--primary); transition:0.3s; width:0%;}
  .trivia-options{display:grid; gap:10px; margin-top:12px;} .trivia-opt{padding:14px 16px; background:var(--card2); border:2px solid var(--border); border-radius:12px; text-align:left; font-weight:600; font-size:14px; cursor:pointer; transition:0.2s; display:flex; gap:10px; align-items:center;} .trivia-opt:hover{border-color:var(--primary); background:var(--card);} .trivia-opt .letter{width:28px; height:28px; background:var(--bg); border:1px solid var(--border); border-radius:8px; display:grid; place-items:center; font-size:12px; font-weight:800; flex-shrink:0;} .trivia-opt.correct{border-color:var(--success); background:rgba(34,197,94,0.15);} .trivia-opt.wrong{border-color:var(--danger); background:rgba(239,68,68,0.15);}
  .code-display{font-family:'JetBrains Mono'; font-size:48px; font-weight:800; letter-spacing:12px; text-align:center; padding:24px; background:var(--bg); border:2px solid var(--primary); border-radius:16px; margin:12px 0; color:var(--primary);} .code-dots{display:flex; gap:12px; justify-content:center; margin:16px 0;} .code-dot{width:16px; height:16px; border-radius:50%; background:var(--card2); border:2px solid var(--border); transition:0.2s;} .code-dot.filled{background:var(--primary); border-color:var(--primary);}
  .toast{position:fixed; bottom:24px; left:50%; transform:translateX(-50%) translateY(100px); background:var(--text); color:var(--bg); padding:12px 18px; border-radius:100px; font-weight:700; font-size:13px; z-index:30000; transition:0.4s cubic-bezier(0.34,1.56,0.64,1); box-shadow:0 10px 30px rgba(0,0,0,0.4); opacity:0;} .toast.show{transform:translateX(-50%) translateY(0); opacity:1;}
</style>
</head>
<body>
<div class="bg-glow"></div>
<div class="login-page" id="loginPage">
  <div class="login-card">
    <div class="login-logo">⏰</div>
    <div class="login-title">Selamat Datang di<br>BangunPintar</div>
    <div class="login-sub">8 Kuis Anti Malas + Atur Jumlah Soal 1-5x! Login dengan Gmail.</div>
    <div class="google-btn-wrap" id="googleBtnWrap"><div id="googleBtn"></div><button class="btn-google-custom" id="customGoogleBtn">Lanjutkan dengan Google</button></div>
    <div class="divider">atau demo tanpa setup</div>
    <div class="demo-login-form"><div><label>Email Gmail</label><input type="email" id="demoEmail" placeholder="nama@gmail.com"></div><div><label>Nama Lengkap</label><input type="text" id="demoName" placeholder="Budi Santoso"></div><button class="btn-demo" id="demoLoginBtn">🚀 Masuk Demo</button></div>
    <div class="login-foot">🔒 Data per akun Gmail. Ganti GOOGLE_CLIENT_ID di kode untuk production.</div>
  </div>
</div>
<div class="container" id="appContainer" style="display:none;">
  <div class="header"><div class="logo"><div class="logo-icon">⏰</div> BangunPintar</div><div class="user-menu" id="userMenuBtn"><div class="user-info"><div class="user-name" id="userName">...</div><div class="user-email" id="userEmail">...</div></div><img class="user-avatar" id="userAvatar" src="" alt=""><div style="font-size:12px; color:var(--muted);">▼</div><div class="dropdown" id="userDropdown"><button id="profileBtn">👤 <span id="dropdownEmail"></span></button><button id="logoutBtn" class="danger">🚪 Logout</button></div></div></div>
  <div class="clock-card"><div class="current-time" id="currentTime">00:00:00</div><div class="current-date" id="currentDate">Memuat...</div><div class="next-alarm" id="nextAlarmInfo">⏰ Belum ada alarm aktif</div></div>
  <div class="section-title">Atur Alarm Baru <span id="userGreeting">10 Kuis Tersedia</span></div>
  <div class="card">
    <div class="form-grid">
      <div class="input-row"><div class="field"><label>Jam Bangun</label><input type="time" id="alarmTime" value="05:00"></div><div class="field"><label>Label</label><input type="text" id="alarmLabel" placeholder="Subuh / Sekolah / Kerja" value="Bangun Pagi"></div></div>
      <div class="field">
        <label>Pilih Metode Mati - 8 KUIS (Bisa Pilih Banyak!)</label>
        <div style="font-size:11px; color:var(--muted); margin-bottom:8px; line-height:1.4;">💡 Kalau Jumlah Soal = 3, kamu bisa pilih 3 kuis beda! Contoh: Soal 1 Matematika, Soal 2 Logika, Soal 3 Emoji. Tap untuk pilih/hapus.</div>
        <div class="quiz-options" id="quizOptions">
          <div class="quiz-opt active" data-type="math"><div class="num">1</div><div class="icon">🧮</div><div class="t">Matematika</div><div class="d">Hitung cepat</div></div>
          <div class="quiz-opt" data-type="logic"><div class="num">2</div><div class="icon">🧩</div><div class="t">Logika Pola</div><div class="d">Lanjutin pola angka</div></div>
          <div class="quiz-opt" data-type="typing"><div class="num">3</div><div class="icon">⌨️</div><div class="t">Ketik</div><div class="d">Ketik kalimat</div></div>
          <div class="quiz-opt" data-type="puzzle"><div class="num">4</div><div class="icon">🔤</div><div class="t">Susun Kata</div><div class="d">Anagram acak</div></div>
          <div class="quiz-opt" data-type="reverse"><div class="num">5</div><div class="icon">🔠</div><div class="t">Kata Terbalik</div><div class="d">Balik kata ini</div></div>
          <div class="quiz-opt" data-type="sort"><div class="num">6</div><div class="icon">🔢</div><div class="t">Urutkan Angka</div><div class="d">Kecil ke besar</div></div>
          <div class="quiz-opt" data-type="emoji"><div class="num">7</div><div class="icon">🧩</div><div class="t">Emoji Rebus</div><div class="d">Tebak dari emoji</div></div>
          <div class="quiz-opt" data-type="trivia"><div class="num">8</div><div class="icon">🌍</div><div class="t">Wawasan Umum</div><div class="d">Kuis pengetahuan</div></div>
        </div>
        <div id="selectedQuizInfo" style="margin-top:12px; padding:10px 14px; background:rgba(255,195,0,0.08); border:1px solid rgba(255,195,0,0.2); border-radius:12px; font-size:12px; line-height:1.5;">
          <span id="selectedQuizList">1. Matematika</span>
        </div>
      </div>
      <div class="field">
        <label>Jumlah Soal Wajib Benar (1-5) 🔥</label>
        <select id="questionCount">
          <option value="1">1 Soal - Pemanasan</option>
          <option value="2">2 Soal - Lumayan</option>
          <option value="3" selected>3 Soal - Standar Anti Malas</option>
          <option value="4">4 Soal - Sulit Bangun!</option>

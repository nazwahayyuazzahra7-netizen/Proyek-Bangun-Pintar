<div class="toast" id="toast">OK</div>
<script>
const GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"; const IS_CLIENT_ID_SET=!GOOGLE_CLIENT_ID.includes("YOUR_GOOGLE");
const $=s=>document.querySelector(s); const $$=s=>document.querySelectorAll(s);
function showToast(msg){ const t=$('#toast'); t.textContent=msg; t.classList.add('show'); setTimeout(()=>t.classList.remove('show'),3000); }
function parseJwt(token){ try{ const b64=token.split('.')[1].replace(/-/g,'+').replace(/_/g,'/'); return JSON.parse(decodeURIComponent(atob(b64).split('').map(c=>'%'+('00'+c.charCodeAt(0).toString(16)).slice(-2)).join(''))); }catch{ return null; } }
function getUserKey(base){ const u=JSON.parse(localStorage.getItem('bp_user')||'null'); return u?`${base}_${u.email}`:base; }
let currentUser=JSON.parse(localStorage.getItem('bp_user')||'null');
function checkAuthState(){ currentUser=JSON.parse(localStorage.getItem('bp_user')||'null'); if(currentUser){ hideLoginPage(); loadUserToUI(); initApp(); } else { showLoginPage(); initGoogleLogin(); } }
function showLoginPage(){ $('#loginPage').classList.remove('hidden'); $('#appContainer').style.display='none'; }
function hideLoginPage(){ $('#loginPage').classList.add('hidden'); $('#appContainer').style.display='block'; }
function initGoogleLogin(){ if(!IS_CLIENT_ID_SET){ $('#googleBtn').style.display='none'; return; } let a=0; const tryInit=()=>{ a++; if(typeof google!=='undefined'&&google.accounts){ google.accounts.id.initialize({client_id:GOOGLE_CLIENT_ID, callback:handleGoogleCredential, auto_select:false}); google.accounts.id.renderButton(document.getElementById('googleBtn'),{theme:'outline', size:'large', shape:'pill', text:'signin_with', width:320}); $('#customGoogleBtn').style.display='none'; google.accounts.id.prompt(); } else if(a<20) setTimeout(tryInit,500); }; tryInit(); }
function handleGoogleCredential(r){ const p=parseJwt(r.credential); if(!p){ showToast('Login gagal'); return; } loginSuccess({email:p.email,name:p.name,picture:p.picture,sub:p.sub,provider:'google',loginAt:new Date().toISOString()}); }
function loginSuccess(u){ localStorage.setItem('bp_user', JSON.stringify(u)); currentUser=u; showToast(`✅ Hai ${u.name}!`); hideLoginPage(); loadUserToUI(); initApp(); }
function loadUserToUI(){ if(!currentUser) return; $('#userName').textContent=currentUser.name||currentUser.email.split('@')[0]; $('#userEmail').textContent=currentUser.email; $('#dropdownEmail').textContent=currentUser.email; $('#userAvatar').src=currentUser.picture||`https://ui-avatars.com/api/?name=${encodeURIComponent(currentUser.name||'User')}&background=FFC300&color=000`; $('#userGreeting').textContent=`Halo, ${currentUser.name.split(' ')[0]}! • 8 Kuis • ${totalQuestionsNeeded}x Soal`; }
$('#customGoogleBtn').addEventListener('click',()=>{ if(IS_CLIENT_ID_SET&&typeof google!=='undefined') google.accounts.id.prompt(); else { showToast('⚠️ Pakai demo login di bawah'); $('#demoEmail').focus(); } });
$('#demoLoginBtn').addEventListener('click',()=>{ const email=$('#demoEmail').value.trim(); const name=$('#demoName').value.trim(); if(!email||!email.includes('@')) return showToast('Email valid dong'); if(!name) return showToast('Nama dong'); const u={email:email.toLowerCase(),name,picture:`https://ui-avatars.com/api/?name=${encodeURIComponent(name)}&background=FFC300&color=000&bold=true`,sub:'demo_'+Date.now(),provider:'demo',loginAt:new Date().toISOString()}; loginSuccess(u); });
$('#userMenuBtn').addEventListener('click',(e)=>{ e.stopPropagation(); $('#userDropdown').classList.toggle('show'); }); document.addEventListener('click',()=>$('#userDropdown').classList.remove('show'));
$('#logoutBtn').addEventListener('click',()=>{ if(confirm('Logout? Data tetap tersimpan.')){ localStorage.removeItem('bp_user'); location.reload(); } });

let alarms=[], streak=0, stats={total:0,onTime:0,questions:0}, selectedQuizTypes=['math'], ringingAlarm=null, currentQuiz=null, audioCtx=null, oscillators=[], gainNode=null, alarmInterval=null, snoozeCount=0, appInitialized=false;
let totalQuestionsNeeded=3, currentQuestionProgress=1;
let currentQuizSequence=[]; // urutan kuis yang dipilih untuk alarm yang bunyi

function updateSelectedQuizUI(){
  const count=parseInt($('#questionCount')?.value||'3');
  const names={math:'Matematika',logic:'Logika Pola',typing:'Ketik',puzzle:'Susun Kata',reverse:'Kata Terbalik',sort:'Urutkan Angka',emoji:'Emoji Rebus',trivia:'Wawasan Umum'};
  const shortNames={math:'🧮MTK',logic:'🧩Logika',typing:'⌨️Ketik',puzzle:'🔤Kata',reverse:'🔠Balik',sort:'🔢Urut',emoji:'🧩Emoji',trivia:'🌍Trivia'};
  const listEl=$('#selectedQuizList');
  const infoEl=$('#selectedQuizInfo');
  
  // Hitung jumlah per tipe
  const countPerType={};
  selectedQuizTypes.forEach(t=>{ countPerType[t]=(countPerType[t]||0)+1; });

  // Update info text
  if(listEl){
    if(selectedQuizTypes.length===0){
      listEl.innerHTML=`<span style="color:var(--danger);">Belum pilih kuis! Tap kuis di atas.</span>`;
      if(infoEl) infoEl.style.borderColor='var(--danger)';
    } else {
      if(infoEl) infoEl.style.borderColor='rgba(255,195,0,0.2)';
      const display=selectedQuizTypes.map((t,i)=>`${i+1}. ${names[t]||t}`).join(' → ');
      const perTypeDisplay=Object.entries(countPerType).map(([t,c])=>`${names[t]} x${c}`).join(', ');
      const remaining=count-selectedQuizTypes.length;
      listEl.innerHTML=`
        <b style="color:var(--primary);">${selectedQuizTypes.length}/${count} Soal Dipilih:</b> ${display}<br>
        <span style="font-size:11px; color:var(--muted);">Rincian: ${perTypeDisplay}</span><br>
        ${remaining>0?`<span style="color:var(--danger); font-size:11px;">⚠️ Kurang ${remaining} lagi! Tap kuis lagi (boleh sama) untuk tambah. Contoh: tap Mengetik 2x = 2 soal Mengetik</span>`:`<span style="color:var(--success); font-size:11px;">✅ Siap! ${count} soal akan muncul urut: ${display}</span>`}
      `;
    }
  }

  // Update visual active + count badge
  $$('.quiz-opt').forEach(opt=>{
    const type=opt.dataset.type;
    const cnt=countPerType[type]||0;
    const indices=[];
    selectedQuizTypes.forEach((t,i)=>{ if(t===type) indices.push(i+1); });
    
    opt.classList.toggle('active', cnt>0);
    const numEl=opt.querySelector('.num');
    if(numEl){
      if(cnt>0){
        numEl.textContent=cnt>1?`${cnt}x`:`${indices[0]}`;
        numEl.style.background='var(--primary)';
        numEl.style.color='#000';
        numEl.style.width=cnt>1?'28px':'16px';
      } else {
        const orig=opt.getAttribute('data-orig-num')||'';
        numEl.textContent=orig;
        numEl.style.background='';
        numEl.style.color='';
        numEl.style.width='16px';
      }
    }
    // Tambah badge urutan kecil kalau dipilih lebih dari 1 tipe
    let orderBadge=opt.querySelector('.order-badge');
    if(cnt>0 && selectedQuizTypes.length>1){
      if(!orderBadge){
        orderBadge=document.createElement('div');
        orderBadge.className='order-badge';
        orderBadge.style.cssText='position:absolute; bottom:6px; left:8px; font-size:8px; font-weight:700; background:var(--card); border:1px solid var(--border); padding:2px 5px; border-radius:100px; color:var(--muted);';
        opt.appendChild(orderBadge);
      }
      orderBadge.textContent=indices.join(',');
      orderBadge.style.display='block';
    } else if(orderBadge){
      orderBadge.style.display='none';
    }
  });
}

function initApp(){
  if(appInitialized) return; appInitialized=true;
  alarms=JSON.parse(localStorage.getItem(getUserKey('bp_alarms'))||'[]'); streak=parseInt(localStorage.getItem(getUserKey('bp_streak'))||'0'); stats=JSON.parse(localStorage.getItem(getUserKey('bp_stats'))||'{"total":0,"onTime":0,"questions":0}');
  updateClock(); setInterval(updateClock,1000); renderAlarms(); updateStatsUI();
  // Save original numbers for UI
  $$('.quiz-opt').forEach(opt=>{ const numEl=opt.querySelector('.num'); if(numEl) opt.setAttribute('data-orig-num', numEl.textContent); });
  // Multi-select logic - BOLEH DUPLIKAT! 1 Math + 2 Typing untuk 3 soal
  $$('.quiz-opt').forEach(el=>{
    el.addEventListener('click',()=>{
      const type=el.dataset.type;
      const count=parseInt($('#questionCount')?.value||'3');
      if(selectedQuizTypes.length < count){
        // Tambah 1 soal tipe ini (boleh duplikat)
        selectedQuizTypes.push(type);
        showToast(`➕ ${type} ditambah (${selectedQuizTypes.length}/${count}) - Tap lagi untuk tambah lagi!`);
      } else {
        // Sudah penuh
        const idx=selectedQuizTypes.indexOf(type);
        if(idx!==-1){
          // Hapus satu instance tipe ini biar bisa ganti komposisi
          selectedQuizTypes.splice(idx,1);
          showToast(`➖ 1x ${type} dihapus (${selectedQuizTypes.length}/${count})`);
        } else {
          showToast(`⚠️ Sudah penuh ${count} soal! Tap kuis yang sudah dipilih untuk hapus 1.`);
          return;
        }
      }
      updateSelectedQuizUI();
    });
  });
  // Ketika jumlah soal diubah, update UI dan batasi pilihan
  $('#questionCount')?.addEventListener('change',()=>{
    const count=parseInt($('#questionCount').value);
    totalQuestionsNeeded=count;
    // Kalau pilihan kuis lebih banyak dari jumlah soal, potong
    if(selectedQuizTypes.length>count){
      selectedQuizTypes=selectedQuizTypes.slice(0,count);
      showToast(`✂️ Pilihan kuis dipotong jadi ${count} sesuai jumlah soal`);
    }
    // Kalau cuma 1 soal dan belum ada pilihan, default math
    if(selectedQuizTypes.length===0) selectedQuizTypes=['math'];
    updateSelectedQuizUI();
    // Update greeting
    const greet=$('#userGreeting'); if(greet) greet.textContent=`Halo, ${currentUser?.name?.split(' ')[0]||'Kamu'}! • ${count} Soal • Pilih ${count} Kuis`;
  });
  updateSelectedQuizUI();
  $('#setAlarmBtn').addEventListener('click',setNewAlarm); $('#submitQuizBtn').addEventListener('click',checkAnswer); $('#snoozeBtn').addEventListener('click',doSnooze);
  if('Notification' in window && Notification.permission==='default') Notification.requestPermission();
  setInterval(checkAlarms,1000);
}
function updateClock(){ const now=new Date(); const ct=$('#currentTime'); if(ct) ct.textContent=now.toLocaleTimeString('id-ID',{hour12:false}); const cd=$('#currentDate'); if(cd) cd.textContent=now.toLocaleDateString('id-ID',{weekday:'long',day:'numeric',month:'long',year:'numeric'}); const active=alarms.filter(a=>a.enabled); if(active.length){ const next=active.sort((a,b)=>a.time.localeCompare(b.time))[0]; $('#nextAlarmInfo').textContent=`⏰ Berikutnya: ${next.time} - ${next.label} (${next.quizType}) • ${currentUser?.email}`; } else $('#nextAlarmInfo').textContent='⏰ Belum ada alarm aktif'; }
function setNewAlarm(){ 
  const time=$('#alarmTime').value; 
  const label=$('#alarmLabel').value||'Bangun Pagi'; 
  const difficulty=$('#difficulty').value; 
  const ringtone=$('#ringtone').value;
  const questionCount=parseInt($('#questionCount')?.value||'3');
  if(!time) return showToast('Pilih jam dulu!'); 
  if(selectedQuizTypes.length===0) return showToast('Pilih minimal 1 kuis!');
  if(selectedQuizTypes.length!==questionCount){
    if(!confirm(`Kamu pilih ${selectedQuizTypes.length} kuis tapi jumlah soal ${questionCount}. ${selectedQuizTypes.length<questionCount?'Kekurangan akan diulang otomatis.':'Kelebihan akan dipotong.'} Lanjut?`)){
      return;
    }
  }
  // Buat sequence kuis sesuai jumlah soal, ulang kalau kurang
  let quizSequence=[...selectedQuizTypes];
  while(quizSequence.length<questionCount){
    // Ulang dari awal
    quizSequence.push(selectedQuizTypes[quizSequence.length % selectedQuizTypes.length]);
  }
  quizSequence=quizSequence.slice(0,questionCount);
  
  const alarm={
    id:Date.now(),
    time,
    label,
    quizType:selectedQuizTypes[0], // backward compat
    quizTypes:[...selectedQuizTypes],
    quizSequence,
    difficulty,
    ringtone,
    questionCount,
    enabled:true,
    created:new Date().toISOString(),
    owner:currentUser?.email
  }; 
  alarms.push(alarm); saveAlarms(); renderAlarms(); 
  const names={math:'Matematika',logic:'Logika',typing:'Ketik',puzzle:'Susun Kata',reverse:'Kata Terbalik',sort:'Urutkan',emoji:'Emoji',trivia:'Trivia'};
  const seqNames=quizSequence.map(t=>names[t]||t).join('→');
  showToast(`✅ Alarm ${time} [${seqNames} x${questionCount}] dipasang!`); 
  if(navigator.vibrate) navigator.vibrate(100); 
}
function saveAlarms(){ localStorage.setItem(getUserKey('bp_alarms'), JSON.stringify(alarms)); }
function saveStats(){ localStorage.setItem(getUserKey('bp_stats'), JSON.stringify(stats)); localStorage.setItem(getUserKey('bp_streak'), streak.toString()); }
function renderAlarms(){ 
  const list=$('#alarmList'); const countEl=$('#alarmCount'); 
  if(countEl) countEl.textContent=`${alarms.length} alarm • ${currentUser?.email}`; 
  if(!alarms.length){ list.innerHTML=`<div style="text-align:center;padding:30px;color:var(--muted);font-size:13px;">Belum ada alarm untuk ${currentUser?.email}<br>Atur di atas untuk mulai.</div>`; return; } 
  const names={math:'🧮MTK',logic:'🧩Logika',typing:'⌨️Ketik',puzzle:'🔤Kata',reverse:'🔠Balik',sort:'🔢Urut',emoji:'🧩Emoji',trivia:'🌍Trivia'};
  list.innerHTML=alarms.map(a=>{
    const seq=a.quizSequence||a.quizTypes||[a.quizType||'math'];
    const seqDisplay=seq.map((t,i)=>`${i+1}.${names[t]||t}`).join(' ');
    const qCount=a.questionCount||seq.length;
    return `<div class="alarm-item ${a.enabled?'':'disabled'}"><div><div class="alarm-time">${a.time}</div><div class="alarm-meta"><span>${a.label}</span><span class="pill">${a.difficulty}</span><span class="pill" style="background:var(--primary); color:#000; border-color:var(--primary);">🔥 ${qCount}x SOAL</span></div><div style="font-size:10px; color:var(--muted); margin-top:4px; line-height:1.3;">${seqDisplay}</div></div><div style="display:flex;align-items:center;gap:12px;"><button onclick="deleteAlarm(${a.id})" style="background:none;border:none;color:var(--muted);cursor:pointer;font-size:18px;">🗑️</button><div class="toggle ${a.enabled?'on':''}" onclick="toggleAlarm(${a.id})"></div></div></div>`;
  }).join(''); 
}
window.toggleAlarm=(id)=>{ alarms=alarms.map(a=>a.id===id?{...a,enabled:!a.enabled}:a); saveAlarms(); renderAlarms(); }
window.deleteAlarm=(id)=>{ if(confirm('Hapus alarm ini?')){ alarms=alarms.filter(a=>a.id!==id); saveAlarms(); renderAlarms(); } }
function checkAlarms(){ if(ringingAlarm) return; const now=new Date(); const hm=now.toTimeString().slice(0,5); const sec=now.getSeconds(); if(sec!==0) return; const matched=alarms.find(a=>a.enabled&&a.time===hm); if(matched) triggerAlarm(matched); }
function triggerAlarm(alarm){ 
  ringingAlarm=alarm; snoozeCount=0; 
  totalQuestionsNeeded=alarm.questionCount|| (alarm.quizSequence?.length) || 3; 
  currentQuestionProgress=1;
  // Tentukan urutan kuis yang akan dipakai
  currentQuizSequence=alarm.quizSequence || alarm.quizTypes || [alarm.quizType||'math'];
  // Kalau urutan kurang dari total, ulang
  while(currentQuizSequence.length < totalQuestionsNeeded){
    currentQuizSequence.push(currentQuizSequence[currentQuizSequence.length % (alarm.quizTypes?.length||1)]);
  }
  currentQuizSequence=currentQuizSequence.slice(0,totalQuestionsNeeded);
  const currentType=currentQuizSequence[0];
  $('#overlayTime').textContent=alarm.time; 
  $('#overlayLabel').textContent=alarm.label.toUpperCase(); 
  $('#quizBadge').textContent=`${currentType.toUpperCase()} • ${alarm.difficulty.toUpperCase()} • 1/${totalQuestionsNeeded}`; 
  $('#snoozeInfo').textContent=`Soal ${currentQuestionProgress}/${totalQuestionsNeeded} [${currentType}] • Snooze: ${snoozeCount}/3`; 
  generateQuiz(currentType, alarm.difficulty); 
  $('#alarmOverlay').classList.add('active'); 
  document.body.style.overflow='hidden'; 
  document.documentElement.style.overflow='hidden'; 
  setTimeout(()=>{ const ov=$('#alarmOverlay'); if(ov) ov.scrollTop=0; },50); 
  startAlarmSound(alarm.ringtone); 
  if('Notification' in window && Notification.permission==='granted'){ new Notification('⏰ '+alarm.label,{body:`Hai ${currentUser?.name}, ${totalQuestionsNeeded} soal: ${currentQuizSequence.join('→')}!`, requireInteraction:true}); } 
  if(navigator.vibrate) navigator.vibrate([1000,500,1000,500,2000]); 
  history.pushState(null,'',location.href); 
  window.onpopstate=()=>{ history.pushState(null,'',location.href); showToast('Selesaikan kuis dulu! 😤'); }; 
}

function generateQuiz(type,diff){
  const content=$('#quizContent');
  const rand=(min,max)=>Math.floor(Math.random()*(max-min+1))+min;
  const resetSubmit=()=>{ const btn=$('#submitQuizBtn'); if(btn){ btn.onclick=checkAnswer; btn.textContent='Matikan Alarm →'; btn.style.display='flex'; } };

  if(type==='math'){
    let a,b,c,question,answer;
    if(diff==='easy'){ a=rand(1,20); b=rand(1,20); const op=Math.random()>0.5?'+':'-'; question=`${a} ${op} ${b} = ?`; answer=op==='+'?a+b:a-b; }
    else if(diff==='medium'){ a=rand(6,15); b=rand(6,15); const ops=['x','+','-']; const op=ops[rand(0,2)]; if(op==='x'){ question=`${a} × ${b} = ?`; answer=a*b; } else if(op==='+'){ question=`${a*2} + ${b*3} = ?`; answer=a*2+b*3; } else { question=`${a*5} - ${b*2} = ?`; answer=a*5-b*2; } }
    else if(diff==='hard'){ a=rand(12,25); b=rand(6,12); c=rand(2,9); question=`${a} × ${b} - ${c*3} = ?`; answer=a*b - c*3; }
    else { a=rand(15,30); b=rand(12,20); c=rand(5,15); question=`(${a} + ${b}) × ${c} ÷ 3 = ?`; answer=Math.floor((a+b)*c/3); }
    currentQuiz={type,answer:answer.toString()}; $('#quizQuestion').textContent=question; $('#quizHint').textContent='Hitung cepat! Salah = suara makin keras.'; content.innerHTML=`<input type="text" inputmode="numeric" class="quiz-input" id="quizInput" placeholder="Jawaban..." autocomplete="off">`; resetSubmit(); setTimeout(()=>$('#quizInput')?.focus(),100);
  }
  else if(type==='logic'){
    // Logika Pola Angka - lanjutin pola
    const patterns=[
      {seq:[2,4,8,16], answer:'32', hint:'x2 terus', type:'x2'},
      {seq:[1,3,6,10,15], answer:'21', hint:'+2,+3,+4,+5,+6', type:'triangular'},
      {seq:[100,90,80,70], answer:'60', hint:'-10 terus', type:'-10'},
      {seq:[3,6,9,12], answer:'15', hint:'+3 terus', type:'+3'},
      {seq:[1,4,9,16], answer:'25', hint:'1²,2²,3²,4²,5²', type:'kuadrat'},
      {seq:[5,10,20,40], answer:'80', hint:'x2', type:'x2'},
      {seq:[2,3,5,8,12], answer:'17', hint:'+1,+2,+3,+4,+5', type:'+n'},
      {seq:[1,1,2,3,5,8], answer:'13', hint:'Fibonacci', type:'fib'},
      {seq:[10,20,30,40], answer:'50', hint:'+10', type:'+10'},
      {seq:[64,32,16,8], answer:'4', hint:'÷2', type:'/2'}
    ];
    let pool=diff==='easy'?patterns.slice(0,4):diff==='medium'?patterns.slice(0,7):patterns;
    const pat=pool[Math.floor(Math.random()*pool.length)];
    currentQuiz={type, answer:pat.answer, seq:pat.seq, hint:pat.hint};
    $('#quizQuestion').textContent=`Lanjutin Pola Ini! 🧩`; 
    $('#quizHint').textContent=`Petunjuk: ${pat.hint} • Pola: ${pat.seq.join(', ')}, ...? • Soal ${currentQuestionProgress}/${totalQuestionsNeeded}`;
    content.innerHTML=`

  <div class="alarm-overlay-top"><div class="time" id="overlayTime">05:00</div><div class="label" id="overlayLabel">BANGUN!</div><div style="margin-top:12px; font-size:12px; opacity:0.8;">🔊 Selesaikan kuis untuk mematikan</div></div>
